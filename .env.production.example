# Copy to ".env" on the server and fill in. NEVER commit the real .env.
# Use letters and digits only in passwords (avoid $ and quotes: Compose interpolates them).

# ---- Compose (MUST be unique per environment) ----
COMPOSE_PROJECT_NAME=laravel-app-uat      # production: laravel-app-prod
APP_PORT=8201                             # uat: 82xx, production: 81xx (localhost only)
COMPOSE_PROFILES=                         # e.g. worker,scheduler
MYSQL_BUFFER_POOL=256M

# ---- Laravel ----
APP_NAME="Laravel App"
APP_ENV=staging                           # production: production
APP_KEY=                                  # generate it, see deploy steps
APP_DEBUG=false
APP_URL=http://localhost
LOG_CHANNEL=stderr                        # logs go to "docker compose logs"

# ---- Database (host "mysql" = compose service name, never localhost) ----
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel_app
DB_USERNAME=laravel_app
DB_PASSWORD=CHANGE_ME_APP_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# ---- Redis ----
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ---- Drivers (older Laravel uses CACHE_DRIVER instead of CACHE_STORE) ----
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
